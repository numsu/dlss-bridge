#include <winver.h>

// Kept in step with DLSS5VK_VERSION_STRING in dlss5-vk-bridge.cpp; these numbers are what the Windows file-properties dialog and any
// tool reading the version resource show.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "dlss5-vulkan-bridge"
#ifdef DLSS5VK_ADDON_HOST
            VALUE "FileDescription",  "DLSS 5 Vulkan Bridge (ReShade add-on)"
#else
            VALUE "FileDescription",  "DLSS 5 Vulkan Bridge (Vulkan layer)"
#endif
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "dlss5-vk-bridge"
#ifdef DLSS5VK_ADDON_HOST
            VALUE "OriginalFilename", "dlss5-vk-bridge.addon64"
#else
            VALUE "OriginalFilename", "dlss5-vk-bridge.dll"
#endif
            VALUE "ProductName",      "DLSS 5 Vulkan Bridge"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
